{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: 运行全部示例",
            "type": "shell",
            "command": "uv run python run_all.py",
            "options": {
                "cwd": "${workspaceFolder}/python"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Python: 运行 pytest",
            "type": "shell",
            "command": "uv run pytest -v",
            "options": {
                "cwd": "${workspaceFolder}/python"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Python: 测试覆盖率",
            "type": "shell",
            "command": "uv run pytest --cov --cov-report=term-missing",
            "options": {
                "cwd": "${workspaceFolder}/python"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Python: Ruff 检查",
            "type": "shell",
            "command": "uv run ruff check .",
            "options": {
                "cwd": "${workspaceFolder}/python"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Docs: 启动教程站点",
            "type": "shell",
            "command": "npm run docs:dev",
            "options": {
                "cwd": "${workspaceFolder}/website"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Docs: 构建教程站点",
            "type": "shell",
            "command": "npm run docs:build",
            "options": {
                "cwd": "${workspaceFolder}/website"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Backend: 启动 FastAPI",
            "type": "shell",
            "command": "uv run uvicorn backend_interview.main:app --reload",
            "options": {
                "cwd": "${workspaceFolder}/python"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Backend: 运行面试场景测试",
            "type": "shell",
            "command": "uv run pytest tests/backend -v",
            "options": {
                "cwd": "${workspaceFolder}/python"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
